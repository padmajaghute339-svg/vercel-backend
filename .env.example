# ========================================================
# CRUNCHYCRAFT BACKEND ENVIRONMENT VARIABLES
# ========================================================

# 1. Database Connection String
# Default: Local SQLite database for zero-config offline execution
DATABASE_URL=sqlite:///./crunchycraft_cinematic.db

# Production: PostgreSQL (Supabase / Render / AWS RDS)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. JWT & Security Keys
SECRET_KEY=crunchycraft_super_secret_concept_key_2026_crunch
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. Supabase Auth / Storage (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 4. Server Port and Host
PORT=8000
HOST=0.0.0.0
